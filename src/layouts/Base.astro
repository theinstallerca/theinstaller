---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { nav, phone, email, city, hours, services, facebook } from '../site';
import { v } from '../img';

// Partner company logo link (top bar and footer).
const partnerLogo = v('/thewindows-logo.svg');
const partnerAlt = 'The Windows – residential PVC window replacement in Winnipeg';
const partnerTitle = 'The Windows: PVC windows for homeowners in Winnipeg (thewindows.ca)';

interface Props { title: string; description?: string; schemaExtra?: object[]; image?: string; }
const { title, schemaExtra = [], image } = Astro.props;
const description = Astro.props.description ?? 'Commercial glazing contractor in Winnipeg. We install curtain wall, storefront entrances, office partitions, commercial and apartment windows, and steel doors.';
const norm = (u: string) => u.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const current = norm(Astro.url.pathname);
const isService = services.some((s) => '/' + s.slug === current);
const canonical = `https://theinstaller.ca${current === '/' ? '/' : current}`;
const heroImage = 'https://theinstaller.ca/images/hero.jpg';
const ogImage = image ? `https://theinstaller.ca${image}` : heroImage;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://theinstaller.ca/#business',
  name: 'Theinstaller',
  slogan: 'Dedicated to install',
  description,
  url: 'https://theinstaller.ca/',
  telephone: phone.tel,
  email,
  image: heroImage,
  sameAs: [facebook],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '17:00' }],
  address: { '@type': 'PostalAddress', addressLocality: 'Winnipeg', addressRegion: 'MB', addressCountry: 'CA' },
  areaServed: [{ '@type': 'City', name: 'Winnipeg' }, { '@type': 'AdministrativeArea', name: 'Manitoba' }],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Installation services',
    itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.text, url: `https://theinstaller.ca/${s.slug}` } })),
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Theinstaller</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Theinstaller" />
    <meta property="og:title" content={`${title} · Theinstaller`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {schemaExtra.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <a href={`tel:${phone.tel}`}>Tel {phone.display}</a>
        <div class="topbar-links">
          <a href="https://thewindows.ca" rel="noopener" class="partner-link" title={partnerTitle}>
            <span>Residential PVC windows →</span>
            <img src={partnerLogo} alt={partnerAlt} width="703" height="96" />
          </a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Theinstaller home"><Logo tagline /></a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="nav" class="nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === norm(n.href) || (isService && n.href === '/services') ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/contact" class="nav-cta">Request a quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <Logo />
          <p style="margin-top: 0.8rem;">Commercial glazing, windows and doors, supplied and installed in {city}.</p>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            {services.map((s) => <li><a href={`/${s.slug}`}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href={`mailto:${email}`}>{email}</a></li>
            <li><a href={`tel:${phone.tel}`}>{phone.display}</a></li>
            <li>{hours}</li>
            <li><a href={facebook} target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
        <div>
          <h4>Residential</h4>
          <ul>
            <li>PVC windows for homeowners are handled by our partner company.</li>
            <li>
              <a href="https://thewindows.ca" rel="noopener" class="partner-logo" title={partnerTitle}>
                <img src={partnerLogo} alt={partnerAlt} width="703" height="96" loading="lazy" />
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Theinstaller</span>
        <span>{city}</span>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
      // Discourage saving photos: no right-click menu and no dragging on images.
      const onImg = (e: Event) => { if ((e.target as HTMLElement).closest('img, .gallery a, .lightbox')) e.preventDefault(); };
      document.addEventListener('contextmenu', onImg);
      document.addEventListener('dragstart', onImg);
    </script>
  </body>
</html>
