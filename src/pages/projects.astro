---
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { projects, categories, home, photoCaption, photoAlt } from '../site';
import { v } from '../img';
---
<Base title="Glazing & Window Installation Projects in Winnipeg" description="Photos of curtain wall, storefront, office partition and window installation work by Theinstaller, Winnipeg.">
  <div class="container page-head">
    <h1>Projects</h1>
    <p>Some of our work in Winnipeg and Manitoba, finished and in progress.</p>
  </div>
  <section class="section" style="padding-top: 2.5rem;">
    <div class="container">
      <div class="filters" role="group" aria-label="Filter photos by type of work">
        <button class="active" data-cat="all" aria-pressed="true">All</button>
        {categories.map((c) => <button data-cat={c.key} aria-pressed="false">{c.label}</button>)}
      </div>
      <div class="gallery">
        {projects.map((p) => {
          const caption = photoCaption(p.cats);
          return (
            <figure data-cats={p.cats.join(' ')}>
              <a href={v(`/images/projects/${p.img}.jpg`)} data-caption={caption}>
                <img src={v(`/images/projects/${p.img}-t.jpg`)} alt={photoAlt(p.cats)} width="800" height="600" loading="lazy" />
              </a>
              <figcaption>{caption}</figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>
  <section class="section section-dark cta-band">
    <div class="container">
      <h2>{home.ctaH}</h2>
      <p>{home.ctaP}</p>
      <a href="/contact" class="btn btn-light">Request a quote</a>
    </div>
  </section>

  <Lightbox />

  <script>
    const figures = [...document.querySelectorAll<HTMLElement>('.gallery figure')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
    function select(cat: string, cats: string[] | null) {
      buttons.forEach((b) => { const on = b.dataset.cat === cat; b.classList.toggle('active', on); b.setAttribute('aria-pressed', String(on)); });
      figures.forEach((f) => { f.hidden = !!cats && !cats.some((c) => f.dataset.cats!.split(' ').includes(c)); });
    }
    buttons.forEach((b) => b.addEventListener('click', () => {
      const cat = b.dataset.cat!;
      select(cat, cat === 'all' ? null : [cat]);
      history.replaceState(null, '', cat === 'all' ? location.pathname : '#' + cat);
    }));
    // Links from the Services page: "Commercial windows" opens both window categories.
    const h = location.hash.slice(1);
    if (h === 'windows') select('', ['windows', 'fiberglass']);
    else if (h && buttons.some((b) => b.dataset.cat === h)) select(h, [h]);
  </script>
</Base>
