---
import Base from '../layouts/Base.astro';
import ServiceMedia from '../components/ServiceMedia.astro';
import { services, home } from '../site';
import { v } from '../img';
---
<Base title="Glazing Installation Services in Winnipeg" description="Curtain wall, storefront and entrances, office partitions, commercial, fiberglass and PVC windows, and hollow metal door installation in Winnipeg.">
  <div class="container page-head">
    <h1>Glazing, window and door installation services in Winnipeg</h1>
    <p>Installation of commercial glazing, windows and doors in Winnipeg and across Manitoba.</p>
  </div>
  <div>
    {services.map((s) => (
      <section class="section service" id={s.key}>
        <div class="container split">
          <div class="media"><ServiceMedia img={s.img} alt={s.name} large /></div>
          <div>
            <h2><a href={`/${s.slug}`}>{s.name}</a></h2>
            <p>{s.text}</p>
            <ul class="checklist">{s.list.map((x) => <li>{x}</li>)}</ul>
            <p><a href={`/${s.slug}`} class="more">+ More about {s.name[0].toLowerCase() + s.name.slice(1)}</a></p>
            {s.key === 'pvc' && (
              <a href="https://thewindows.ca" rel="noopener" class="partner-link partner-link-lg" title="The Windows: PVC windows for homeowners in Winnipeg (thewindows.ca)">
                <span>Residential PVC windows →</span>
                <img src={v('/thewindows-logo.svg')} alt="The Windows – residential PVC window replacement in Winnipeg" width="703" height="96" loading="lazy" />
              </a>
            )}
          </div>
        </div>
      </section>
    ))}
  </div>
  <section class="section section-dark cta-band">
    <div class="container">
      <h2>{home.ctaH}</h2>
      <p>{home.ctaP}</p>
      <a href="/contact" class="btn btn-light">Request a quote</a>
    </div>
  </section>
</Base>
