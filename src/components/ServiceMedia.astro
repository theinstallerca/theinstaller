---
import GlazingArt from './GlazingArt.astro';
import { v } from '../img';
interface Props { img?: string; alt: string; large?: boolean; }
const { img, alt, large = false } = Astro.props;
---
{img
  ? <img src={v(`/images/projects/${img}${large ? '' : '-t'}.jpg`)} alt={alt} loading="lazy" />
  : <GlazingArt kind="doors" />}
