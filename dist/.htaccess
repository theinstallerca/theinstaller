# Serve /about as about.html, etc.
RewriteEngine On

# One address for the whole site: send http:// and www. to https://theinstaller.ca (permanent redirect).
# /.well-known/ is left alone so the hosting's SSL certificate renewal keeps working.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://theinstaller.ca%{REQUEST_URI} [L,R=301]

# Hotlink protection: other websites cannot display our photos straight from this server.
# Requests with no referrer (typed address, privacy tools) and our two own sites are allowed.
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?theinstaller\.ca(/|$) [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?thewindows\.ca(/|$) [NC]
RewriteRule \.(jpe?g|png|webp|gif)$ - [F,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

AddDefaultCharset UTF-8

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# HTML must always be revalidated; hashed assets can be cached long
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
